<?xml version="1.0" encoding="UTF-8"?>

<!--
Default logback configuration provided for import
-->

<configuration>
        <!-- Appender Console -->
        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">

            <encoder>
                <pattern>
                    %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n
                </pattern>
            </encoder>

        </appender>

        <!-- Appender Fichier -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>./logs/my-app-logs.log</file>
            <append>true</append>
            <encoder>
                <pattern>
                    %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n
                </pattern>
            </encoder>

            <!-- Politique de rotation -->
            <rollingPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- Nom des fichiers archivés -->
                <fileNamePattern>
                    ./logs/archive/my-app-%d{yyyy-MM-dd}.%i.log
                </fileNamePattern>
                <!-- Taille maximale par fichier -->
                <maxFileSize>1KB</maxFileSize>
                <!-- Conservation des archives -->
                <maxHistory>30</maxHistory>
                <!-- Taille totale maximale des archives -->
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>

        </appender>

        <!-- Configuration Root -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>


</configuration>